<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 2.x maintenance line: .NET Framework only (the code uses WPF + System.Drawing). -->
    <TargetFrameworks>net40;net45;net452;net46;net461</TargetFrameworks>
    <AssemblyName>ThaiNationalIDCard</AssemblyName>
    <RootNamespace>ThaiNationalIDCard</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <DebugType>pdbonly</DebugType>

    <!-- Assembly version stays 2.0.0.0 so existing binding redirects keep working. -->
    <Version>2.0.1</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.1.0</FileVersion>

    <!-- NuGet package metadata -->
    <PackageId>ThaiNationalIDCard</PackageId>
    <Authors>chakphanu</Authors>
    <Product>ThaiNationalIDCard</Product>
    <Copyright>Copyright (c) 2013, chakphanu</Copyright>
    <Description>Thai national ID card (smartcard) reader helper over PC/SC. Reads citizen id, names, birthday, address, issue/expire and photo.</Description>
    <PackageTags>thai;national-id;idcard;smartcard;pcsc</PackageTags>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/chakphanu/ThaiNationalIDCard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chakphanu/ThaiNationalIDCard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>2.0.1: bug-fix release, API unchanged. See CHANGELOG.md.</PackageReleaseNotes>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Declared as NuGet dependencies, so the nupkg depends on PCSC 5.0.0 (not pcsc-sharp). -->
    <PackageReference Include="PCSC" Version="5.0.0" />
    <PackageReference Include="PCSC.Iso7816" Version="5.0.0" />

    <!-- Lets net40..net461 compile on machines without the .NET Framework targeting packs. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Personal.PhotoBitmap uses WPF JpegBitmapDecoder and System.Drawing.Bitmap. -->
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
