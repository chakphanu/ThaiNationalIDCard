<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The tool and the console sample are net10.0 only. The main test project also runs net8.0, so this one stays separate. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ThaiNationalIDCard.Tests\SimulatedCard.cs" Link="Shared\SimulatedCard.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\ThaiNationalIDCard.Diagnose\ThaiNationalIDCard.Diagnose.csproj" />
    <ProjectReference Include="..\..\samples\ConsoleSample\ConsoleSample.csproj" />
    <ProjectReference Include="..\..\src\ThaiNationalIDCard\ThaiNationalIDCard.csproj" />
  </ItemGroup>

</Project>
