<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>ThaiNationalIDCard</RootNamespace>
    <AssemblyName>ThaiNationalIDCard</AssemblyName>

    <!-- ThrowIfNull and ThrowIf do not exist on netstandard2.0, which this library also targets. -->
    <NoWarn>$(NoWarn);CA1510;CA1513</NoWarn>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>ThaiNationalIDCard</PackageId>
    <Authors>chakphanu</Authors>
    <Description>Reads a Thai national ID card through PC/SC, with a choice of what to read. Public mode is the default, and private mode is a separate explicit choice. Reading is not proof of identity, and the caller is responsible for the holder's consent. Preview: not tested on a real card yet.</Description>
    <PackageTags>thai;thailand;national-id;idcard;smartcard;pcsc</PackageTags>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/chakphanu/ThaiNationalIDCard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chakphanu/ThaiNationalIDCard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PCSC" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- TIS-620 decoding: CodePagesEncodingProvider is built into net8.0 and later, a package on netstandard2.0. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Encoding.CodePages" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ThaiNationalIDCard.Tests" />
    <InternalsVisibleTo Include="ThaiNationalIDCard.Diagnose.Tests" />
    <!-- The trace tool needs diagnostics with field bytes cleared early, which the public reader does not offer. -->
    <InternalsVisibleTo Include="thaiid-diagnose" />
  </ItemGroup>

  <!-- Public API baseline. Nothing of v3 has shipped yet, so everything is still in the unshipped files. -->
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI\PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- ThaiCardDate.ToDateOnly exists only where DateOnly does. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <AdditionalFiles Include="PublicAPI\net\PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
